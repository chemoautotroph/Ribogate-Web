# Loaded automatically; environment variables override this file.
# setup.ps1 generates a private .env with a unique persistent secret.
RIBOGATE_SECRET_KEY=replace-with-a-long-random-secret
RIBOGATE_HOST=127.0.0.1
RIBOGATE_PORT=8000
RIBOGATE_SERVER_NAME=127.0.0.1:8000
RIBOGATE_URL_SCHEME=http
RIBOGATE_NUM_PROCESSES=2
# Leave unset to use the automatically downloaded files in vienna_rna_binaries/.
# RIBOGATE_VIENNA_PATH=C:/path/to/customized/ViennaRNA
# Leave unset to store DB, sessions and logs in instance/.
# RIBOGATE_DATA_DIR=C:/path/to/private/runtime-data
RIBOGATE_SEND_EMAILS=false
RIBOGATE_EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=
SMTP2GO_API_KEY=
RIBOGATE_EMAIL_FROM=
RIBOGATE_ADMIN_EMAIL=

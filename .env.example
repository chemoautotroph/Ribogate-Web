# Set these as environment variables; this app does not load .env automatically.
RIBOGATE_SECRET_KEY=replace-with-a-long-random-secret
RIBOGATE_HOST=127.0.0.1
RIBOGATE_PORT=8000
RIBOGATE_VIENNA_PATH=C:/path/to/customized/ViennaRNA
# Optional when enabling email:
SENDGRID_API_KEY=
SMTP2GO_API_KEY=
RIBOGATE_EMAIL_FROM=
RIBOGATE_ADMIN_EMAIL=
